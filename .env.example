# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored, never commit real secrets.

# A long random string used to sign sessions/cookies
SECRET_KEY=change-me-to-a-long-random-string

# Database connection.
# Local dev (SQLite): sqlite:///lms.db
# Supabase Postgres : postgresql://postgres:[YOUR-DB-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///lms.db

# Supabase project (optional; only needed for Storage / Auth / REST features)
SUPABASE_URL=https://jrzskqtvadfoirejqgle.supabase.co
SUPABASE_KEY=sb_publishable_82z9uIMWcfDkJXas5mpLLQ_u2ghhSZ6

# Set to 1 to drop & recreate tables on startup (DESTRUCTIVE — dev only).
# Defaults: 1 for SQLite, 0 for any other DB.
INIT_DB_RESET=

# Set to 0 to skip seeding demo users/courses
INIT_DB_SEED=1
