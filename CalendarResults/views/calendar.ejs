<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1a237e">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        .calendar-month {
            margin-bottom: 2rem;
        }
        .calendar-month h3 {
            margin-bottom: 1rem;
            color: #1a237e;
        }
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }
        .calendar-day-header {
            font-weight: bold;
            text-align: center;
            padding: 5px;
            background-color: #e0e0e0;
        }
        .calendar-day {
            min-height: 80px;
            padding: 5px;
            border: 1px solid #e0e0e0;
            position: relative;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .calendar-day:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transform: translateY(-2px);
            border-color: #4a90e2;
        }
        .calendar-day.empty {
            background-color: #f5f5f5;
            cursor: default;
        }
        .calendar-day.empty:hover {
            box-shadow: none;
            transform: none;
            border-color: #e0e0e0;
        }
        .calendar-day .date {
            position: absolute;
            top: 5px;
            right: 5px;
            font-size: 0.8rem;
            color: #666;
        }
        .calendar-event {
            font-size: 0.8rem;
            margin-top: 20px;
            padding: 3px;
            border-radius: 3px;
            margin-bottom: 3px;
        }
        .event-exam {
            background-color: #ffcdd2;
        }
        .event-workshop {
            background-color: #c8e6c9;
        }
        .event-holiday {
            background-color: #bbdefb;
        }
        .event-deadline {
            background-color: #ffe0b2;
        }
        .day-content {
            font-size: 0.8rem;
            margin-top: 20px;
            word-wrap: break-word;
        }
        .edit-button {
            position: absolute;
            top: 5px;
            left: 5px;
            cursor: pointer;
            background: rgba(255,255,255,0.7);
            border-radius: 4px;
            transition: all 0.2s;
            color: #aaa;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .edit-button:hover {
            background: rgba(0,0,0,0.05);
            transform: translateY(-1px);
            color: #4a90e2;
        }
        .has-event {
            border-left: 3px solid #4a90e2;
        }
        #editOverlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            z-index: 1000;
        }
        #editOverlay.active {
            display: block;
        }
        #editPopup {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.2);
            width: 90%;
            max-width: 600px;
            z-index: 1001;
            display: none;
        }
        #editPopup.active {
            display: block;
        }
        .popup-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }
        .popup-header h3 {
            margin: 0;
            font-size: 1.2rem;
        }
        .popup-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #666;
        }
        .popup-footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 10px;
        }
        .highlight-options {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0;
            padding: 8px;
            border: 1px solid #eee;
            border-radius: 6px;
            background: #f8f9fa;
        }
        .highlight-option {
            width: 22px;
            height: 22px;
            border-radius: 3px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s;
        }
        .highlight-option:hover {
            transform: scale(1.1);
        }
        .highlight-option.selected {
            border-color: #333;
            transform: scale(1.1);
        }
        .highlight-option.none { background: #fff; border: 2px dashed #ccc; }
        .highlight-option.yellow { background: #fff3cd; }
        .highlight-option.green { background: #d4edda; }
        .highlight-option.blue { background: #cce5ff; }
        .highlight-option.red { background: #f8d7da; }
        .highlight-option.purple { background: #e2d9f3; }
        .highlight-option.gray { background: #e9ecef; }
        .highlight-option.orange { background: #ffe5d0; }
        .highlight-option.pink { background: #f8d7e6; }
        .highlight-option.sky { background: #d4f1f9; }
        .highlight-option.lime { background: #e8ffd4; }
        .highlight-option.rose { background: #ffb6c1; }
        .highlight-option.aqua { background: #00ffff80; }
        .highlight-option.gold { background: #ffd70080; }
        .highlight-option.lavender { background: #e6e6fa; }
        .highlight-option.teal { background: #80ffd480; }
        .highlight-option.salmon { background: #ffa07a80; }
    </style>
</head>
